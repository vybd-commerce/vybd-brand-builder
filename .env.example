DATABASE_URL=postgresql+psycopg://vybd:vybd@localhost:5433/vybd
TEST_DATABASE_URL=postgresql+psycopg://vybd:vybd@localhost:5433/vybd_test

# --- Models: provider-agnostic, OpenAI-compatible. Default = OpenRouter, free models only. ---
LLM_PROVIDER=fake                      # fake | openai_compat
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                           # OpenRouter key (sk-or-...)
# Free lineup changes often — check openrouter.ai/models. Picked 2026-11-01: JSON-capable free models.
LLM_MODEL=google/gemma-4-31b-it:free
LLM_MODELS=google/gemma-4-26b-a4b-it:free,openrouter/free   # fallbacks (OpenRouter `models`)
ALLOW_PAID_MODELS=false                # true lifts the ':free'-only guard

EMBED_PROVIDER=fake                    # fake | openai_compat
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=                         # defaults to LLM_API_KEY if empty
EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBED_DIM=1024                         # must match the model; baked into the brain migration

SEARCH_PROVIDER=fake

# --- App ---
SCORER=completeness_v0
ADMIN_EMAILS=ashwin@vybd.ai
AUTO_APPROVE_RUNS=false
RUN_BUDGET_MAX_WALL_SECONDS=36000
RUN_BUDGET_MAX_TOKENS=2000000
RUN_BUDGET_MAX_COST_USD=25
RUN_BUDGET_MAX_STEPS=400

VYBD_API_URL=http://localhost:8000
